# Nexo · proxy web. Caddy obtiene y renueva solo el certificado HTTPS del dominio (Let's Encrypt)
# siempre que el registro DNS del dominio apunte a este servidor y los puertos 80 y 443 estén abiertos.
{$NEXO_DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Robots-Tag "noindex, nofollow"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Ambiente de demostración: que los buscadores no lo indexen.
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}

	# Servicio de aplicación (acceso, sesiones, permisos y consultas).
	handle /api/* {
		reverse_proxy servicio:3000
	}

	# Interfaz de Nexo (app/web): página, código y logotipo. Sin caché para que cada actualización llegue de inmediato.
	handle {
		root * /srv/sitio
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
