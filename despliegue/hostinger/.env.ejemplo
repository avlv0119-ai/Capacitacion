# Nexo · variables del despliegue. NO subas el archivo .env al repositorio.
# Créalo con: scripts/secretos.sh  (llena los secretos con valores aleatorios y deja permisos 600)

# Dominio o subdominio que apunta a este servidor (registro A en hPanel → DNS).
NEXO_DOMINIO=capacitacion.ejemplo.com

# Usuario dueño de la base (solo para migraciones, respaldos y mantenimiento).
POSTGRES_USER=nexo_admin
POSTGRES_PASSWORD=

# Contraseña del usuario limitado con el que se conecta el servicio (sin permisos de borrado y con reglas por fila).
NEXO_DB_PASSWORD=

# Secreto del servidor para las huellas de códigos y claves de acceso (mínimo 32 caracteres).
# Si se pierde, los códigos de activación pendientes dejan de servir (las frases de acceso no se ven afectadas).
NEXO_PEPPER=

# Respaldos (scripts/respaldo.sh)
NEXO_RESPALDOS=/var/backups/nexo
NEXO_RETENCION_DIAS=14
# Opcional: destino remoto para copiar cada respaldo con rsync (por ejemplo, usuario@otro-servidor:/respaldos/nexo)
NEXO_RESPALDO_REMOTO=

# Opcional: cambiar los puertos publicados (solo para pruebas locales).
# NEXO_PUERTO_HTTP=80
# NEXO_PUERTO_HTTPS=443
